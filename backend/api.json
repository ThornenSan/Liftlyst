{
    "openapi": "3.1.0",
    "info": {
        "title": "Liftlyst",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8080/api"
        }
    ],
    "paths": {
        "/v1/exercises": {
            "get": {
                "operationId": "v1.exercises.index",
                "description": "Returns every exercise, ordered by name.",
                "summary": "List exercises",
                "tags": [
                    "Exercise"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Exercise"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "operationId": "v1.exercises.store",
                "description": "Idempotent on the client-supplied `uuid`. An offline client generates the\nuuid before sending, so a push that is retried after a lost response\nupdates the existing exercise instead of creating a duplicate.",
                "summary": "Create or update an exercise",
                "tags": [
                    "Exercise"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreExerciseRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "An exercise with this uuid already existed and was updated. A retried push lands here \u2014 treat it as success.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation failed.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Errors overview."
                                        },
                                        "errors": {
                                            "type": "object",
                                            "description": "A detailed description of each field that failed validation.",
                                            "additionalProperties": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    },
                                    "required": [
                                        "message",
                                        "errors"
                                    ]
                                }
                            }
                        }
                    },
                    "201": {
                        "description": "The exercise was created.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/v1/health": {
            "get": {
                "operationId": "v1.health",
                "description": "Returns 200 with `{\"status\": \"ok\"}` when the API is reachable and the\nframework boots. Deliberately shallow - it does not check database or\ncache connectivity, so a slow dependency cannot make this endpoint slow.",
                "summary": "Health check",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Exercise": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "uuid": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    }
                },
                "required": [
                    "id",
                    "uuid",
                    "name",
                    "created_at",
                    "updated_at"
                ],
                "title": "Exercise"
            },
            "StoreExerciseRequest": {
                "type": "object",
                "properties": {
                    "uuid": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "name": {
                        "type": "string",
                        "maxLength": 255
                    }
                },
                "required": [
                    "uuid",
                    "name"
                ],
                "title": "StoreExerciseRequest"
            }
        }
    }
}