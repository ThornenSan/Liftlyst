# Optional — leave unset for simulators.
#
# src/config/env.ts picks the right default per platform:
#   iOS simulator     http://localhost:8080/api/v1
#   Android emulator  http://10.0.2.2:8080/api/v1
#
# Set API_BASE_URL only when neither default applies:
#
#   physical device   your machine's LAN IP, e.g. http://192.168.1.42:8080/api/v1
#                       macOS    ipconfig getifaddr en0
#                       Linux    hostname -I | awk '{print $1}'
#                       Windows  (Get-NetIPAddress -AddressFamily IPv4 -InterfaceAlias 'Wi-Fi').IPAddress
#
#   remote host       https://staging.example.com/api/v1
#
# Read at build time, not runtime — changing it needs a rebuild, not a reload.
#
# API_BASE_URL=
